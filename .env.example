# Postgres connection (read by both the API and the batching worker process)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=websg_whitelist

# HTTP port for the API process (src/main.ts)
PORT=3000

# Whether to mount the Swagger UI at /api/docs. Optional — if unset, defaults
# to enabled everywhere except NODE_ENV=production. Set explicitly to
# override that default in either direction (e.g. "true" to allow it in a
# production-labeled container).
WHITELIST_SWAGGER_ENABLED=true

# Max combined add+remove entries accepted per POST /api/whitelist/ip-addresses request (default: 50)
WHITELIST_MAX_ENTRIES_PER_REQUEST=50

# How often the batching worker checks for and publishes whitelist changes, in ms (default: 30000, per section 3c's 30-60s window)
WHITELIST_BATCH_INTERVAL_MS=30000

# Shared secret GitHub signs webhook payloads with (X-Hub-Signature-256, HMAC-SHA256).
# Required for POST /api/whitelist/webhooks/terraform-apply to accept requests — without it, every call is rejected.
WHITELIST_WEBHOOK_SECRET=changeme

# GitHub repo the batching worker commits the generated ip_whitelist.tfvars.json to.
# All three of OWNER/REPO/TOKEN must be set, or the worker falls back to NoopPublisher (logs instead of committing).
# Generate a token at https://github.com/settings/personal-access-tokens
# WHITELIST_GITHUB_OWNER=your-org
# WHITELIST_GITHUB_REPO=your-infra-repo
# WHITELIST_GITHUB_TOKEN=ghp_xxx
WHITELIST_GITHUB_OWNER=
WHITELIST_GITHUB_REPO=
WHITELIST_GITHUB_TOKEN=

# Optional — defaults shown; only needed to point at a different path/branch in the infra repo
WHITELIST_GITHUB_PATH=cms-whitelist/ip_whitelist.tfvars.json
WHITELIST_GITHUB_BRANCH=main
