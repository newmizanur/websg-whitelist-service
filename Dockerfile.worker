# Builds and runs the standalone batching worker (src/worker.ts) — no HTTP
# server. See Dockerfile.api for the API's image; same build shape, separate
# image/container per docker-compose.yml.

FROM node:24-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm build

FROM node:24-alpine AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/dist ./dist

USER node
CMD ["node", "dist/worker.js"]
